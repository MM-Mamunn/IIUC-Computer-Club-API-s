{
  "buildCommand": "npm run vercel-build",
  "outputDirectory": ".",
  "regions": [
    "iad1"
  ],
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api"
    }
  ],
  "redirects": [
    {
      "source": "/",
      "destination": "/api",
      "permanent": false
    }
  ]
}
