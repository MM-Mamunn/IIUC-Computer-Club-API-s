{
  "name": "iiuc-computer-club-api",
  "type": "module",
  "private": true,
  "devDependencies": {
    "@types/bcryptjs": "^3.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^25.3.0",
    "@types/nodemailer": "^7.0.11",
    "drizzle-kit": "^0.31.11",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "vercel": "^64.0.2"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.19",
    "@neondatabase/serverless": "^1.0.2",
    "@vercel/functions": "^3.11.3",
    "bcryptjs": "^3.0.3",
    "cloudinary": "^2.11.0",
    "dotenv": "^17.3.1",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.19",
    "jsonwebtoken": "^9.0.3",
    "nodemailer": "^10.6.0",
    "postgres": "^3.4.8"
  },
  "scripts": {
    "dev": "node node_modules/tsx/dist/cli.mjs watch src/server.ts",
    "dev:bun": "bun run --watch src/server.ts",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push",
    "db:reset": "bun run src/scripts/reset-db.ts",
    "db:seed": "bun run src/scripts/seed.ts",
    "db:seed-dmau": "bun run src/scripts/seed-dmau.ts",
    "db:seed-female": "bun run src/scripts/seed-female-committee.ts",
    "db:seed-massive": "bun run src/scripts/seed-massive.ts",
    "db:migrate-images": "node node_modules/tsx/dist/cli.mjs src/scripts/migrate-base64-images.ts",
    "db:apply-migration": "node node_modules/tsx/dist/cli.mjs src/scripts/apply-sql-migration.ts",
    "db:fix-slugs": "node node_modules/tsx/dist/cli.mjs src/scripts/fix-event-slugs.ts",
    "start": "vercel dev",
    "deploy": "vercel",
    "vercel-build": "esbuild src/vercel.ts --bundle --outfile=api/index.mjs --platform=node --target=node18 --format=esm --banner:js=\"import{createRequire}from'module';const require=createRequire(import.meta.url);\""
  },
  "overrides": {
    "tar": "^7.5.22",
    "lodash": "^4.18.1"
  }
}
