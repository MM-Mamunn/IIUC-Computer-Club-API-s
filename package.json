{
  "name": "iiuc-computer-club-api",
  "private": true,
  "devDependencies": {
    "@types/bcryptjs": "^3.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^25.3.0",
    "@types/nodemailer": "^7.0.11",
    "drizzle-kit": "^0.31.9",
    "esbuild": "^0.27.3",
    "vercel": "^50.23.1"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.9",
    "@neondatabase/serverless": "^1.0.2",
    "bcryptjs": "^3.0.3",
    "cloudinary": "^2.9.0",
    "dotenv": "^17.3.1",
    "drizzle-orm": "^0.45.1",
    "hono": "^4.11.9",
    "jsonwebtoken": "^9.0.3",
    "nodemailer": "^8.0.1",
    "postgres": "^3.4.8"
  },
  "scripts": {
    "dev": "bun run --watch src/server.ts",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push",
    "db:reset": "bun run src/scripts/reset-db.ts",
    "db:seed": "bun run src/scripts/seed.ts",
    "db:seed-dmau": "bun run src/scripts/seed-dmau.ts",
    "db:seed-massive": "bun run src/scripts/seed-massive.ts",
    "start": "vercel dev",
    "deploy": "vercel",
    "vercel-build": "esbuild src/vercel.ts --bundle --outfile=api/index.mjs --platform=node --target=node18 --format=esm --banner:js=\"import{createRequire}from'module';const require=createRequire(import.meta.url);\""
  }
}
